###
# ============================================
# VALIDE REQUESTS (Sollten funktionieren)
# ============================================
###

###
# 10. Create valid task
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Valid Task",
  "description": "This is a valid task description",
  "priority": "high"
}
# Erwartet: 201 Created

###
# 11. Update task with valid data
PUT {{baseUrl}}/api/tasks/task-1
Content-Type: application/json

{
  "status": "completed",
  "priority": "low"
}
# Erwartet: 200 OK

###
# 12. Delete existing task
DELETE {{baseUrl}}/api/tasks/task-3
# Erwartet: 204 No Content
