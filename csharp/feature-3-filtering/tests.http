###
# 14. Create a new task (für Test-Daten)
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Test Task for Filtering",
  "description": "This is a test task",
  "priority": "medium"
}
# Erwartet: 201 Created

###
# 15. Update task status
PUT {{baseUrl}}/api/tasks/task-3
Content-Type: application/json

{
  "status": "completed"
}
# Erwartet: 200 OK
