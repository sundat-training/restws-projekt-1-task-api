@baseUrl = http://localhost:3005

###############################################
# Task Management API - Feature 5: Auth
# TEST-SZENARIEN (ca. 1/2 als AUFGABE)
###############################################

###
# ============================================
# REFERENZ: Login Tests (bereits funktionsfähig)
# ============================================
###

###
# 1. Login with valid credentials
# BEREITS FUNKTIONSFÄHIG - Zeigt wie Login funktioniert
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "alice",
  "password": "password123"
}
# Erwartet: 200 OK mit { userId, username }

###
# 2. Login with invalid credentials
# BEREITS FUNKTIONSFÄHIG - Zeigt Fehlerbehandlung
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "alice",
  "password": "wrongpassword"
}
# Erwartet: 401 Unauthorized

###
# 3. Login with non-existent user
# BEREITS FUNKTIONSFÄHIG - Zeigt Fehler bei unbekanntem User
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "nonexistentuser",
  "password": "password123"
}
# Erwartet: 401 Unauthorized

###
# ============================================
# REFERENZ: Auth-Middleware Tests (bereits funktionsfähig)
# ============================================
###

###
# 4. Get tasks without auth
# BEREITS FUNKTIONSFÄHIG - Zeigt 401 ohne Auth
GET {{baseUrl}}/api/tasks
# Erwartet: 401 Unauthorized

###
# 5. Get tasks with valid auth
# BEREITS FUNKTIONSFÄHIG - Zeigt erfolgreichen Auth-Request
GET {{baseUrl}}/api/tasks
Authorization: Bearer user-1
# Erwartet: 200 OK mit Tasks des Users

###
# 6. Create task with auth
# BEREITS FUNKTIONSFÄHIG - Zeigt POST mit Auth
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer user-1

{
  "title": "New Task for Alice",
  "description": "This task belongs to the authenticated user",
  "priority": "high"
}
# Erwartet: 201 Created mit userId des eingeloggten Users

