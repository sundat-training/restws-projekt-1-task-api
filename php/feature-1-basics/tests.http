# Testet: 404 bei PUT auf nicht-existenten Task
PUT {{baseUrl}}/api/tasks/non-existent-id
Content-Type: application/json

{
  "status": "completed"
}
# Erwartet: 404 Not Found

###
# 9. Delete non-existent task
# Testet: 404 bei DELETE auf nicht-existenten Task
DELETE {{baseUrl}}/api/tasks/non-existent-id
# Erwartet: 404 Not Found

###
# 10. Update with empty body
# Testet: PUT ohne Felder gibt 400
PUT {{baseUrl}}/api/tasks/task-1
Content-Type: application/json

{}
# Erwartet: 400 Bad Request

