###
# ============================================
# BEREITS IMPLEMENTIERT - Referenz aus Feature 1
# ============================================
###

###
# 1. Get all tasks
# Bereits implementiert - dient als Referenz
GET {{baseUrl}}/api/tasks

###
# 2. Get single task by ID
# Bereits implementiert - dient als Referenz
GET {{baseUrl}}/api/tasks/task-1

###
# ============================================
# AUFGABE 1: POST Validierung implementieren + TEST SCHREIBEN
# ============================================
###

###
# 3. Create valid task
# Sollte funktionieren (keine Validierungsfehler)
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "New Valid Task",
  "description": "This task has all required fields",
  "priority": "high"
}
# Erwartet: 201 Created

###
# 4. Create task without title
# LÖSE SELBER:
#   1. Implementiere Validierung: title ist Pflichtfeld
#   2. Schreibe diesen Test:
#      - POST an /api/tasks
#      - JSON Body OHNE title
#      - Erwartet: 400 Bad Request mit "Title is required"
POST {{baseUrl}}/api/tasks
Content-Type: application/json

# TODO: Schreibe den Request Body OHNE title Feld:
# {
#   "description": "..."
# }

###
# 5. Create task with empty title
# LÖSE SELBER:
#   1. Implementiere Validierung: title darf nicht leer sein
#   2. Schreibe diesen Test:
#      - POST an /api/tasks
#      - JSON Body mit title: "" (leerer String)
#      - Erwartet: 400 Bad Request
POST {{baseUrl}}/api/tasks
Content-Type: application/json

# TODO: Schreibe den Request Body mit leerem title:
# {
#   "title": "",
#   "description": "..."
# }

###
# 6. Create task with title too long (>200 chars)
# LÖSE SELBER:
#   1. Implementiere Validierung: max 200 Zeichen für title
#   2. Schreibe diesen Test:
#      - POST an /api/tasks
#      - JSON Body mit title > 200 Zeichen
#      - Erwartet: 400 Bad Request - "Title max 200 chars"
POST {{baseUrl}}/api/tasks
Content-Type: application/json

# TODO: Schreibe den Request Body mit sehr langem title:
# Tipp: Verwende einen String mit mehr als 200 Zeichen
# {
#   "title": "Dieser Titel ist viel zu lang und überschreitet die maximal erlaubten 200 Zeichen deutlich...",
#   "description": "..."
# }

###
# ============================================
# AUFGABE 2: POST Enum-Validierung implementieren + TEST SCHREIBEN
