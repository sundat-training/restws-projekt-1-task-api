###
# 7. Create task with invalid priority
# LÖSE SELBER:
#   1. Implementiere Validierung: priority muss "low", "medium" oder "high" sein
#   2. Schreibe diesen Test:
#      - POST an /api/tasks
#      - JSON Body mit priority: "invalid"
#      - Erwartet: 400 Bad Request - "Invalid priority"
POST {{baseUrl}}/api/tasks
Content-Type: application/json

# TODO: Schreibe den Request Body mit ungültigem priority:
# {
#   "title": "...",
#   "description": "...",
#   "priority": "invalid"
# }

###
# 8. Create task without description
# LÖSE SELBER:
#   1. Implementiere Validierung: description ist Pflichtfeld
#   2. Schreibe diesen Test:
#      - POST an /api/tasks
#      - JSON Body OHNE description
#      - Erwartet: 400 Bad Request - "Description is required"
POST {{baseUrl}}/api/tasks
Content-Type: application/json

# TODO: Schreibe den Request Body OHNE description:
# {
#   "title": "..."
# }

###
# ============================================
# AUFGABE 3: PUT Validierung implementieren + TEST SCHREIBEN
# ============================================
###

###
# 9. Update task with valid status
# Sollte funktionieren
PUT {{baseUrl}}/api/tasks/task-1
Content-Type: application/json

{
  "status": "completed"
}
# Erwartet: 200 OK

###
# 10. Update task with invalid status
# LÖSE SELBER:
#   1. Implementiere Validierung: status muss "pending", "in_progress" oder "completed" sein
