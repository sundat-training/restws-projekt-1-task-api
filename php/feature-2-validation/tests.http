#      - PUT an /api/tasks/task-2
#      - JSON Body mit status: "not_a_valid_status"
#      - Erwartet: 400 Bad Request - "Invalid status"
PUT {{baseUrl}}/api/tasks/task-2
Content-Type: application/json

# TODO: Schreibe den Request Body mit ungültigem status:
# {
#   "status": "..."
# }

###
# 11. Update task with title too long
# LÖSE SELBER:
#   1. Implementiere Validierung: max 200 Zeichen für title (auch bei PUT)
#   2. Schreibe diesen Test:
