@baseUrl = http://localhost:3006

# =============================================================================
# Task Management API - Reference Solution (Feature Complete)
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication Tests
# -----------------------------------------------------------------------------

# 1: Login als alice
# @name loginAlice
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "alice",
  "password": "password123"
}

# Erwartete Response:
# HTTP/1.1 200 OK
# {"success":true,"message":"Login erfolgreich","user":{"id":1,"username":"alice"},"token":"user-1"}

###

# 2: Login als bob
# @name loginBob
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "bob",
  "password": "password456"
}

# Erwartete Response:
# HTTP/1.1 200 OK
# {"success":true,"message":"Login erfolgreich","user":{"id":2,"username":"bob"},"token":"user-2"}

###

# 3: Login mit falschen Daten (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "alice",
  "password": "falschespasswort"
}

# Erwartete Response:
# HTTP/1.1 401 Unauthorized
# {"success":false,"error":"Ungültige Zugangsdaten"}

###

# -----------------------------------------------------------------------------
# Tasks Tests
# -----------------------------------------------------------------------------

# 4: GET alle Tasks mit Auth
GET {{baseUrl}}/api/tasks
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "data": [
#     {"id": 1, "title": "Projekt planen", "description": "...", "status": "pending", "priority": "high", "user_id": 1, ...}
#   ],
#   "pagination": {"page": 1, "limit": 10, "total": 3, "total_pages": 1}
# }

###

# 5: GET Tasks mit Pagination (page=1, limit=2)
GET {{baseUrl}}/api/tasks?page=1&limit=2
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "data": [...2 Tasks...],
#   "pagination": {"page": 1, "limit": 2, "total": 3, "total_pages": 2}
# }

###

# 6: GET Tasks mit Filter (status=pending)
GET {{baseUrl}}/api/tasks?status=pending
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "data": [...nur pending Tasks...],
#   "pagination": {"page": 1, "limit": 10, "total": 2, "total_pages": 1}
# }

###

# 7: GET Tasks mit kombiniertem Filter (status + priority)
GET {{baseUrl}}/api/tasks?status=pending&priority=high
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "data": [...nur pending + high Tasks...],
#   "pagination": {"page": 1, "limit": 10, "total": 1, "total_pages": 1}
# }

###

# 8: GET Tasks mit Search
GET {{baseUrl}}/api/tasks?search=documentation
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "data": [...Tasks mit "documentation" im Titel...],
#   "pagination": {"page": 1, "limit": 10, "total": 1, "total_pages": 1}
# }

###

# 9: GET einzelnen Task
GET {{baseUrl}}/api/tasks/1
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "data": {"id": 1, "title": "Projekt planen", ...}
# }

###

# 10: POST neuen Task
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer user-1

{
  "title": "API Dokumentation erstellen",
  "description": "Vollständige API Dokumentation für das Projekt",
  "priority": "high"
}

# Erwartete Response:
# HTTP/1.1 201 Created
# {
#   "success": true,
#   "message": "Task erstellt",
#   "data": {"id": 4, "title": "API Dokumentation erstellen", ...}
# }

###

# 11: PUT Task aktualisieren
PUT {{baseUrl}}/api/tasks/1
Content-Type: application/json
Authorization: Bearer user-1

{
  "title": "API Dokumentation aktualisieren",
  "status": "in_progress"
}

# Erwartete Response:
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "message": "Task aktualisiert",
#   "data": {"id": 1, "title": "API Dokumentation aktualisieren", "status": "in_progress", ...}
# }

###

# 12: DELETE Task
DELETE {{baseUrl}}/api/tasks/1
Authorization: Bearer user-1

# Erwartete Response:
# HTTP/1.1 200 OK
# {"success": true, "message": "Task gelöscht"}

###

# -----------------------------------------------------------------------------
# Security Tests
# -----------------------------------------------------------------------------

# 13: Zugriff ohne Auth (401)
GET {{baseUrl}}/api/tasks

# Erwartete Response:
# HTTP/1.1 401 Unauthorized
# {"success":false,"error":"Authentifizierung erforderlich"}

###

# 14: Zugriff auf fremden Task (404)
GET {{baseUrl}}/api/tasks/100
Authorization: Bearer user-2

# Erwartete Response:
# HTTP/1.1 404 Not Found
# {"success":false,"error":"Task nicht gefunden"}

###
